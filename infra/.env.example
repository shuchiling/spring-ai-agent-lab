# 仅限本机开发。复制为 infra/.env 后替换为本机专用值，切勿用于非 local 环境。
# 启动基建：在 infra/ 目录执行 docker compose up -d

# PostgreSQL
POSTGRES_DB=agent_lab
POSTGRES_USER=agent
POSTGRES_PASSWORD=123456
DB_URL=jdbc:postgresql://localhost:5432/agent_lab
DB_USER=agent
DB_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

# 模型（OpenAI 兼容接口）
API_KEY=
API_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
